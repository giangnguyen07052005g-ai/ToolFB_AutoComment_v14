<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>14.1.1</Version>
    <AssemblyVersion>14.1.1.0</AssemblyVersion>
    <FileVersion>14.1.1.0</FileVersion>
    <Product>GIANG DEV Bình Luận Facebook Pro</Product>
    <Description>Phần Mềm Tự Động Bình Luận &amp; Nuôi Tương Tác Facebook Pro v14 - GIANG DEV</Description>
    <Company>GIANG DEV</Company>
    <Authors>GIANG DEV</Authors>
    <Copyright>© 2026 GIANG DEV. All rights reserved.</Copyright>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolFB.Updater\ToolFB.Updater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyUpdater" AfterTargets="Build">
    <ItemGroup>
      <UpdaterFiles Include="..\ToolFB.Updater\bin\$(Configuration)\net8.0\ToolFB.Updater.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
