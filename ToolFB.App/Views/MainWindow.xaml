                                        <TextBlock Text="✈️ Hỗ Trợ Quản Trị Viên:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InfoBlue}" Margin="0,0,0,4" />
                                        <TextBlock Text="Telegram Admin: @abc_abc_05 (Chat ID: 6425719277)" FontSize="12" Foreground="{StaticResource TextWhite}" Margin="0,0,0,8" />
