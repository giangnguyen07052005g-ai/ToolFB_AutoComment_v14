                                                        <TextBlock Text="Giới hạn comment tối đa / Mỗi Token" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextWhite}" />
                                                        <TextBlock Text="Tự động ngưng sử dụng Token khi đạt đủ số cmt chỉ định" FontSize="11" Foreground="{StaticResource TextDim}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBox x:Name="EntMaxCmtToken" Text="50" Width="55" Height="28" HorizontalContentAlignment="Center" TextChanged="ConfigInput_TextChanged" />
                                                        <TextBlock Text="cmt" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Giới hạn comment tối đa / Mỗi Bài Viết" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextWhite}" />
                                                            <TextBlock Text="Số lượt bình luận trên 1 bài viết mục tiêu trước khi hoàn thành" FontSize="11" Foreground="{StaticResource TextDim}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBox x:Name="EntMaxCmtPost" Text="1" Width="55" Height="28" HorizontalContentAlignment="Center" TextChanged="ConfigInput_TextChanged" />
                                                            <TextBlock Text="lượt" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Hàng 4: Phân Bổ & Khởi Động -->
                                        <Border Background="#161920" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <CheckBox x:Name="ChkRoundRobin" Content="Kích hoạt True Round-Robin (Chia đều danh sách bài viết cho các token)" IsChecked="True" Margin="0,0,0,8" />
                                                <CheckBox x:Name="ChkWarmup" Content="Khởi động Token trước khi chạy (Warmup kiểm tra quyền Graph API)" IsChecked="True" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- CỘT 2 (PHẢI): ANTI-BAN, NGHỈ THÔNG MINH & TƯƠNG TÁC -->
                                <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock Text="🛡️ BẢO VỆ TÀI KHOẢN, ANTI-BAN &amp; TƯƠNG TÁC" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessGreen}" VerticalAlignment="Center" />
