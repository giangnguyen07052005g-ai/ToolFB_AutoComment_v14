                                                    <TextBlock Text="Số luồng chạy song song (Slots / Workers)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextWhite}" />
                                                    <TextBlock Text="Số tài khoản Facebook cùng bình luận đồng thời (Khuyên dùng: 2 - 5)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="—" Width="28" Height="28" Style="{StaticResource BtnBase}" Padding="0" Click="BtnSlotsMinus_Click" ToolTip="Giảm 1 luồng" />
                                                    <TextBox x:Name="EntSlots" Text="3" Width="48" Height="28" HorizontalContentAlignment="Center" Margin="4,0" TextChanged="ConfigInput_TextChanged" />
                                                    <Button Content="+" Width="28" Height="28" Style="{StaticResource BtnBase}" Padding="0" Click="BtnSlotsPlus_Click" ToolTip="Tăng 1 luồng" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Hàng 2: Độ Trễ Ngẫu Nhiên Delay -->
                                        <Border Background="#161920" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <DockPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Khoảng cách chờ ngẫu nhiên (Random Delay)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextWhite}" />
                                                    <TextBlock Text="Thời gian nghỉ ngẫu nhiên giữa 2 lần cmt của mỗi nick (chống spam)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBox x:Name="EntDelayMin" Text="30" Width="45" Height="28" HorizontalContentAlignment="Center" TextChanged="ConfigInput_TextChanged" />
                                                    <TextBlock Text="giây  →" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0" FontSize="11" />
                                                    <TextBox x:Name="EntDelayMax" Text="60" Width="45" Height="28" HorizontalContentAlignment="Center" TextChanged="ConfigInput_TextChanged" />
                                                    <TextBlock Text="giây" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Hàng 3: Giới Hạn Bình Luận Tối Đa -->
                                        <Border Background="#161920" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
