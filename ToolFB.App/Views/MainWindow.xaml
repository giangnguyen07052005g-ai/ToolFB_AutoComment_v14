                                                <TextBlock Text="An Toàn" FontSize="10" FontWeight="Bold" Foreground="#A7F3D0" />
                                            </Border>
                                        </DockPanel>

                                        <!-- Hàng 1: Chế Độ Nghỉ Thông Minh Smart Rest -->
                                        <Border Background="#161920" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Chế độ nghỉ thông minh đường dài (Smart Rest)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextWhite}" />
                                                <TextBlock Text="Tự động cho tài khoản nghỉ xả hơi sau một số cmt để xóa cờ quét của Facebook" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="50" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="50" /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Cứ sau " Foreground="{StaticResource TextBody}" VerticalAlignment="Center" FontSize="12" />
                                                    <TextBox Grid.Column="1" x:Name="EntSmartRestAfter" Text="10" Height="28" HorizontalContentAlignment="Center" Margin="4,0" TextChanged="ConfigInput_TextChanged" />
                                                    <TextBlock Grid.Column="2" Text="cmt  →  Nghỉ " Foreground="{StaticResource TextBody}" VerticalAlignment="Center" FontSize="12" />
                                                    <TextBox Grid.Column="3" x:Name="EntSmartRestDuration" Text="60" Height="28" HorizontalContentAlignment="Center" Margin="4,0" TextChanged="ConfigInput_TextChanged" />
                                                    <TextBlock Grid.Column="4" Text="giây" Foreground="{StaticResource TextBody}" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Hàng 2: Tự Động Xoay Proxy & Mạng -->
                                        <Border Background="#161920" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <CheckBox x:Name="ChkAutoRotateProxy" Content="Tự động xoay Proxy / gán lại IP khi phát hiện lỗi mạng" IsChecked="True" />
                                        </Border>

                                        <!-- Hàng 3: Thả Reaction Cảm Xúc -->
                                        <Border Background="#161920" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <DockPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <CheckBox x:Name="ChkSendReactions" Content="Tự động thả Reaction cảm xúc trước khi cmt" Margin="0,0,0,4" />
                                                    <TextBlock Text="Tăng tương tác tự nhiên, giảm tỷ lệ bị nghi ngờ là bot" FontSize="11" Foreground="{StaticResource TextDim}" />
                                                </StackPanel>
                                                <ComboBox x:Name="CboReactionType" Width="115" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="👍 LIKE" IsSelected="True" />
                                                    <ComboBoxItem Content="❤️ LOVE" />
                                                    <ComboBoxItem Content="🥰 CARE" />
                                                    <ComboBoxItem Content="😆 HAHA" />
                                                    <ComboBoxItem Content="😮 WOW" />
                                                </ComboBox>
                                            </DockPanel>
                                        </Border>

                                        <!-- Hàng 4: Bộ Tấm Khiên Anti-Ban Tích Hợp Sẵn -->
                                        <Border Background="#0B1D19" BorderBrush="#065F46" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🛡️ CƠ CHẾ BẢO VỆ NICK TỰ ĐỘNG ĐANG BẬT:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,4" />
                                                <TextBlock Text="• 3-Strike Block: Lỗi nhẹ lần 1-2 chỉ lùi thời gian; Lỗi lần 3 mới khóa, tuyệt đối không chết nick oan." FontSize="11" Foreground="#A7F3D0" TextWrapping="Wrap" Margin="0,0,0,2" />
                                                <TextBlock Text="• Rate Limit Backoff: Tự động lùi thời gian cấp số nhân (120s → 240s → 600s) khi gặp lỗi 17/341." FontSize="11" Foreground="#6EE7B7" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Hàng 5: Hệ Thống & Bảo Mật DPAPI -->
                                        <Border Background="#14171E" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <DockPanel>
                                                <CheckBox x:Name="ChkAutoUpdateStartup" Content="Tự động kiểm tra cập nhật khi khởi động" IsChecked="True" VerticalAlignment="Center" />
                                                <TextBlock Text="🔒 DPAPI Encrypted" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- 3. Thanh Nút Thao Tác Dưới Cùng -->
                        <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="💾 Lưu Cấu Hình" Style="{StaticResource BtnPrimary}" MinWidth="130" Height="32" Margin="0,0,8,0" Click="BtnSaveConfig_Click" />
                                    <Button Content="🔄 Tải Lại Cấu Hình" Style="{StaticResource BtnBase}" MinWidth="130" Height="32" Margin="0,0,8,0" Click="BtnReloadConfig_Click" />
                                    <Button Content="⚠️ Khôi Phục Mặc Định" Style="{StaticResource BtnDanger}" MinWidth="150" Height="32" Click="BtnResetDefaults_Click" />
                                </StackPanel>
                                <TextBlock Text="🔒 Toàn bộ cấu hình và dữ liệu Token được tự động mã hóa bằng Windows DPAPI an toàn tuyệt đối" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- TRANG 6: 📜 NHẬT KÝ & CHẨN ĐOÁN (ACTIVITY LOGS)              -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <Grid x:Name="PageLogs" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Log Toolbar -->
                        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="RadLogAll" Content="Tất Cả" Style="{StaticResource SubSegmentedPill}" IsChecked="True" Checked="LogFilter_Changed" />
                                    <RadioButton x:Name="RadLogSuccess" Content="✅ Thành Công" Style="{StaticResource SubSegmentedPill}" Checked="LogFilter_Changed" />
                                    <RadioButton x:Name="RadLogWarning" Content="⚠️ Cảnh Báo" Style="{StaticResource SubSegmentedPill}" Checked="LogFilter_Changed" />
                                    <RadioButton x:Name="RadLogError" Content="❌ Lỗi" Style="{StaticResource SubSegmentedPill}" Checked="LogFilter_Changed" />

                                    <TextBox x:Name="EntSearchLogs" Width="150" Height="28" Padding="6,2" Margin="10,0,10,0" ToolTip="Tìm kiếm từ khóa trong log" TextChanged="TxtSearchLogs_TextChanged" />
                                    <CheckBox x:Name="ChkAutoScroll" Content="📌 Ghim cuộn" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <Button Content="📋 Copy Chọn" Style="{StaticResource BtnBase}" Height="28" Margin="0,0,4,0" Click="BtnCopySelectedLog_Click" />
                                    <Button Content="📤 Xuất TXT" Style="{StaticResource BtnBase}" Height="28" Margin="0,0,4,0" Click="BtnExportLogs_Click" />
                                    <Button Content="🗑 Xóa Log" Style="{StaticResource BtnDanger}" Height="28" Click="BtnClearLogs_Click" />
                                </StackPanel>

                                <TextBlock x:Name="LblLogCounter" Text="Tổng dòng: 0" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryGold}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Log Viewer Virtualized ListBox -->
                        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                            <ListBox x:Name="ListLogs" Background="{StaticResource CardBg}" BorderThickness="0"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="{StaticResource TextDim}" FontFamily="Consolas, Segoe UI" FontSize="11" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="2,0,6,0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Level}" Foreground="{Binding ForegroundBrush}" FontWeight="Bold" FontSize="10" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{Binding ForegroundBrush}" FontFamily="Consolas, Segoe UI" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- TRANG 7: ⚡ GIẤY PHÉP & CẬP NHẬT GITHUB                      -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <Grid x:Name="PageLicense" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cột Trái: Bản Quyền & Thiết Bị -->
                        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="⚡ BẢN QUYỀN &amp; ĐỊNH DANH THIẾT BỊ" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryGold}" Margin="0,0,0,12" />

                                <TextBlock Text="Mã Hardware ID (HWID máy tính):" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
