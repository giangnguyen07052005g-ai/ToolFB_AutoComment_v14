                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock Text="🚀 VẬN HÀNH ĐA LUỒNG &amp; TỐC ĐỘ CHIẾN DỊCH" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryGold}" VerticalAlignment="Center" />
                                            <Border Background="#261E05" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="Hiệu Suất" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryGold}" />
                                            </Border>
                                        </DockPanel>

                                        <!-- Hàng 1: Số Luồng Chạy Song Song -->
                                        <Border Background="#161920" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
