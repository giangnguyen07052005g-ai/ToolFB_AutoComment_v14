<Window x:Class="ToolFB.App.Views.LinksViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem danh sách" Height="500" Width="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource BorderBrushColor}"
            BorderThickness="1.5" CornerRadius="10">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="DANH SÁCH LIÊN KẾT ĐÃ BÌNH LUẬN" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource AccentCyan}" />
                    <TextBlock x:Name="TxtCount" Text="(0 mục)" Foreground="{StaticResource TextSecondary}"
                               FontSize="13" Margin="8,2,0,0" />
                </StackPanel>

                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Style="{StaticResource BtnBase}" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextSecondary}" Click="BtnClose_Click" />
            </Grid>

            <!-- Content Viewer -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="8">
                <TextBox x:Name="TxtContent" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True" FontFamily="Consolas, Segoe UI" FontSize="12" />
            </Border>

            <!-- Footer Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Mở file bên ngoài" Style="{StaticResource BtnBase}" Margin="0,0,8,0" Click="BtnOpenExternal_Click" />
                <Button Content="Xóa file" Style="{StaticResource BtnDanger}" Margin="0,0,8,0" Click="BtnClear_Click" />
                <Button Content="Sao chép tất cả" Style="{StaticResource BtnPrimary}" Click="BtnCopyAll_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
