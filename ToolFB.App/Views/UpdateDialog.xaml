<Window x:Class="ToolFB.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật phiên bản mới" Height="480" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource AccentCyan}"
            BorderThickness="1.5" CornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Version Info -->
                <RowDefinition Height="*" />    <!-- Release Notes -->
                <RowDefinition Height="Auto" /> <!-- Progress Bar -->
                <RowDefinition Height="Auto" /> <!-- Status & Actions -->
            </Grid.RowDefinitions>

            <!-- Window Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀 CẬP NHẬT PHIÊN BẢN MỚI" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource AccentCyan}" />
                    <Border x:Name="BadgeMandatory" Background="{StaticResource AccentRed}" CornerRadius="4"
                            Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="BẮT BUỘC" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Style="{StaticResource BtnBase}" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextSecondary}" Click="BtnClose_Click" />
            </Grid>

            <!-- Version Comparison Card -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,15" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phiên bản hiện tại" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock x:Name="TxtCurrentVersion" Text="v14.0.0" Foreground="{StaticResource TextPrimary}"
                                   FontSize="15" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="➔" Foreground="{StaticResource AccentCyan}"
                               FontSize="18" VerticalAlignment="Center" Margin="15,0" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Phiên bản mới nhất" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock x:Name="TxtLatestVersion" Text="v14.1.0" Foreground="{StaticResource AccentGreen}"
                                   FontSize="15" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Release Notes -->
            <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,15" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Nội dung cập nhật:" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtReleaseNotes" Text="Nội dung ghi chú cập nhật..."
                                   Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Progress Section -->
            <StackPanel Grid.Row="3" x:Name="PanelProgress" Margin="0,0,0,15" Visibility="Collapsed">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="TxtProgressStatus" Text="Đang tải..." Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    <TextBlock x:Name="TxtPercent" Text="0%" Foreground="{StaticResource AccentCyan}" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="ProgressBarDownload" Minimum="0" Maximum="100" Value="0" Height="8" />
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="4">
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng cập nhật" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"
                           HorizontalAlignment="Left" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRetry" Content="Thử lại" Style="{StaticResource BtnWarning}"
                            Margin="0,0,10,0" Visibility="Collapsed" Click="BtnRetry_Click" />

                    <Button x:Name="BtnCancel" Content="Hủy" Style="{StaticResource BtnBase}"
                            Margin="0,0,10,0" Visibility="Collapsed" Click="BtnCancel_Click" />

                    <Button x:Name="BtnRemindLater" Content="Để sau" Style="{StaticResource BtnBase}"
                            Margin="0,0,10,0" Click="BtnRemindLater_Click" />

                    <Button x:Name="BtnUpdateNow" Content="Cập nhật ngay" Style="{StaticResource BtnPrimary}"
                            Click="BtnUpdateNow_Click" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
