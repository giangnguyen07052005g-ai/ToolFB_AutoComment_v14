<Window x:Class="ToolFB.App.Views.ActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIANG DEV — Quản Lý &amp; Kích Hoạt Bản Quyền"
        Height="510" Width="560" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/ToolFB.App;component/Assets/app_icon.ico">

    <Border Background="{StaticResource BgCanvas}" BorderBrush="{StaticResource BorderBrushColor}"
            BorderThickness="1" CornerRadius="12">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Status label -->
                <RowDefinition Height="Auto" /> <!-- HWID Box -->
                <RowDefinition Height="Auto" /> <!-- Key Entry Box -->
                <RowDefinition Height="Auto" /> <!-- Action buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔐 XÁC THỰC BẢN QUYỀN TOOL FB PRO" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PrimaryGold}" HorizontalAlignment="Center" />
                    <TextBlock Text="GIANG DEV ULTIMATE 2026 EDITION" FontSize="11"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource BtnBase}" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource DangerRed}" Click="BtnClose_Click" />
            </Grid>

            <!-- 2. Status Label -->
            <Border Grid.Row="1" Background="#181A20" BorderBrush="{StaticResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                <TextBlock x:Name="LblStatus" Text="Đang kiểm tra bản quyền..." FontWeight="Bold" FontSize="11.5"
                           Foreground="{StaticResource DangerRed}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>

            <!-- 3. Box HWID -->
            <Border Grid.Row="2" Background="#1E2329" BorderBrush="{StaticResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="MÃ MÁY CỦA BẠN (GỬI MÃ NÀY CHO ADMIN):" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtHwid" Grid.Column="0" Height="36" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                 Foreground="{StaticResource PrimaryGold}" Background="#12151B"
                                 BorderBrush="{StaticResource BorderLight}" VerticalContentAlignment="Center" Padding="8,4" />

                        <Button x:Name="BtnCopyHwid" Grid.Column="1" Content="📋 Copy HWID" Style="{StaticResource BtnBase}"
                                MinWidth="110" Height="36" Margin="8,0,0,0" Click="BtnCopyHwid_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Box Nhập Key -->
            <Border Grid.Row="3" Background="#1E2329" BorderBrush="{StaticResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="NHẬP MÃ KÍCH HOẠT / MÃ GIA HẠN (NẾU CÓ KEY TỪ ADMIN):" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />

                    <TextBox x:Name="TxtKey" Height="36" FontFamily="Consolas, Segoe UI" FontSize="12.5"
                             Foreground="{StaticResource TextWhite}" Background="#12151B"
                             BorderBrush="{StaticResource BorderLight}" VerticalContentAlignment="Center" Padding="8,4" />
                </StackPanel>
            </Border>

            <!-- 5. Action Buttons -->
            <StackPanel Grid.Row="4">
                <Button x:Name="BtnActivate" Content="⚡ KÍCH HOẠT / GIA HẠN BẢN QUYỀN NGAY" Style="{StaticResource BtnPrimary}"
                        Height="38" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,8" Click="BtnActivate_Click" />

                <Button x:Name="BtnRecheck" Content="🔄 Kiểm Tra Lại (Nếu Admin Đã Bấm Cấp Trên Bot)" Style="{StaticResource BtnBase}"
                        Height="33" Margin="0,0,0,8" Click="BtnRecheck_Click" />

                <Button Content="✈️ Gửi Mã Máy Cho Admin Kích Hoạt (@abc_abc_05)" Style="{StaticResource BtnBase}"
                        Background="#182A3A" BorderBrush="#1E4968" Foreground="#29B6F6"
                        Height="32" Click="BtnOpenTelegram_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
